  "lint-staged": {
    "**/*.{js,ts,cjs,jsx,tsx}": [
      "eslint --fix",
      "prettier --write -u"
    ],
    "!**/*.{js,ts,cjs,jsx,tsx}": "prettier --write -u"
  },
  "engines": {
    "node": ">=22.22.0"
  },
