{
  "name": "tarjonta-pulssi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "dev:local": "DATABASE=file react-router dev",
    "dev:localdb": "DATABASE=local react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier": "prettier . --check -u",
    "prettier:fix": "prettier . --write -u",
    "test": "jest",
    "umzug": "tsx ./shared/db/umzug/migrate.ts",
    "database": "./test/tools/start_postgresql && pnpm run umzug up",
    "import-db-dumps": "./test/tools/import_db_dumps.sh",
    "prepare-test-env": "pnpm run database && pnpm run import-db-dumps",
    "preinstall": "pnpx only-allow@1.2.2 pnpm",
    "prepare": "husky install",
    "cdk": "cdk",
    "cdk:synth": "pnpm run build && cdk synth",
    "cdk:diff": "pnpm run build && cdk diff",
    "cdk:deploy": "pnpm run build && cdk deploy --all",
    "cdk:destroy": "cdk destroy --all"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.449.0",
    "@aws-sdk/client-ssm": "^3.427.0",
    "@elastic/elasticsearch": "^7.17.0",
