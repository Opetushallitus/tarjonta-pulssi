    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/system": "^5.18.0",
    "@mui/utils": "^5.17.1",
    "@mui/x-date-pickers": "^7.29.4",
    "@react-router/architect": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "i18next": "^23.6.0",
    "isbot": "^5.1.0",
    "lodash": "^4.18.0",
    "pg": "^8.11.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^13.4.0",
    "react-router": "^8.4.0",
    "ts-pattern": "^5.0.5",
    "umzug": "^3.3.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@types/aws-lambda": "^8.10.126",
    "@types/jest": "^29.5.8",
    "@types/lodash": "^4.14.201",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.10.9",
