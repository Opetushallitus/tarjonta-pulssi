{
  "include": ["**/*.ts", "**/*.tsx"],
  // server/lambda.ts importtaa käännetyn palvelinbundlen, jota ei ole olemassa
  // typecheckin aikaan. Ks. tiedoston oma kommentti.
  "exclude": ["node_modules", "build", "cdk.out", "server/lambda.ts"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "jest", "vite/client"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/app/*": ["./app/*"],
      "~/shared/*": ["./shared/*"],
      "~/functions/*": ["./functions/*"]
    },
    // react-router build hoitaa kääntämisen, tsc:tä käytetään vain tarkistukseen.
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
